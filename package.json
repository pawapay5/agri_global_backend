{
  "name": "agriprice",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "contract:lint": "pnpm --filter @agriprice/contracts lint",
    "contract:gen": "pnpm --filter @agriprice/contracts generate",
    "contract:check": "pnpm --filter @agriprice/api contract:check",
    "db:migrate": "pnpm --filter @agriprice/api db:migrate",
    "db:rollback": "pnpm --filter @agriprice/api db:rollback",
    "db:seed": "pnpm --filter @agriprice/api db:seed"
  },
  "devDependencies": {
    "turbo": "2.11.13",
    "typescript": "5.9.3"
  }
}
