{
  "name": "@agriprice/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./openapi.yaml": "../../openapi/openapi.yaml"
  },
  "files": ["dist"],
  "scripts": {
    "lint": "redocly lint ../../openapi/openapi.yaml --config redocly.yaml",
    "generate": "openapi-typescript ../../openapi/openapi.yaml -o src/generated/schema.ts",
    "build": "pnpm generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@redocly/cli": "2.82.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
