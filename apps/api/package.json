{
  "name": "@agriprice/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/migrate.mjs up",
    "db:rollback": "node scripts/migrate.mjs down",
    "db:status": "node scripts/migrate.mjs status",
    "db:seed": "pnpm build && node dist/seed/seed.cli.js",
    "openapi:emit": "pnpm build && node dist/openapi/check.js --emit-only",
    "contract:check": "pnpm build && node dist/openapi/check.js"
  },
  "dependencies": {
    "@agriprice/contracts": "workspace:*",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.8.0",
    "argon2": "0.45.2",
    "bullmq": "6.7.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^7.0.3",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "0.45.4",
    "helmet": "^8.3.0",
    "ioredis": "5.11.1",
    "jose": "6.2.18",
    "otplib": "12.0.1",
    "pg": "8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "11.2.11",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
