# ---- shared ----
NODE_ENV=development
DATABASE_URL=postgres://agriprice:agriprice@localhost:5432/agriprice
REDIS_URL=redis://localhost:6379

# ---- api ----
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-bytes-long
JWT_ISSUER=agriprice
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# 32-byte base64 key used to encrypt TOTP secrets at rest (AES-256-GCM)
FIELD_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
OTP_PEPPER=change-me-otp-pepper

# OAuth ID-token audiences (comma separated client IDs)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- storage ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=agriprice
S3_SECRET_KEY=agriprice-secret
S3_BUCKET_REPORTS=agriprice-reports
S3_BUCKET_IMAGES=agriprice-images

# ---- search (optional) ----
SEARCH_PROVIDER=postgres   # postgres | meilisearch
MEILI_URL=http://localhost:7700
MEILI_KEY=dev-master-key-change-me

# ---- notifications ----
EMAIL_PROVIDER=smtp        # smtp | ses | postmark
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="AgriPrice <no-reply@agriprice.app>"
POSTMARK_TOKEN=
AWS_SES_REGION=
SMS_PROVIDER=log           # log | africastalking | twilio
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
# Shared secret appended as ?token= to Africa's Talking, Postmark and SES receipt webhook URLs
WEBHOOK_SHARED_SECRET=

# ---- ml ----
ML_SERVICE_URL=http://localhost:8001
MLFLOW_TRACKING_URI=http://localhost:5000
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
